# =============================================================
# EXAMPLE settings file (SAFE to share - has NO real secrets).
# Copy this to a file named ".env" and fill in real values.
# ".env" is git-ignored, so your real keys never reach GitHub.
# =============================================================

# offline = free local mode (mock LLM). online = real Claude.
APP_MODE=offline

# Secret key for Claude. Leave blank in offline mode.
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=1024
# Only if your key is identity-linked and asks for a workspace id (else blank).
ANTHROPIC_WORKSPACE_ID=
# SSL for the Claude call. On a corporate network/VPN with SSL inspection,
# set LLM_CA_BUNDLE to your company's CA .pem. Or set LLM_VERIFY_SSL=false to
# DISABLE verification (INSECURE - local testing only).
LLM_CA_BUNDLE=
LLM_VERIFY_SSL=true

# Document chunking settings (numbers, not secrets).
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# Embedding model.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector database ---
# "local" = free in-memory (default). "pinecone" = managed cloud DB.
VECTOR_BACKEND=local

# Fill these ONLY if VECTOR_BACKEND=pinecone. Get a free key at pinecone.io.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tenet-clinical
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LangSmith tracing (optional observability). Get a key at smith.langchain.com ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tenet-clinical-ai
